# Environment Variables Template for AI Query Optimizer
# Create this key in Google AI Studio. Do not paste a Google OAuth access token here.
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dvd_rental
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
# Use require for Neon/Supabase/Aiven. Local PostgreSQL usually uses prefer or disable.
DB_SSLMODE=prefer
